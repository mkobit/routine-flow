{
  "name": "routine-flow",
  "version": "0.0.1",
  "description": "Customizable routine timer with Obsidian Bases support.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "bun esbuild.config.mjs production",
    "dev": "bun esbuild.config.mjs",
    "docs:build": "cd docs && bun run build",
    "docs:dev": "cd docs && bun run start",
    "docs:screenshots": "bun x playwright test --config=e2e/capture-screenshots.playwright.config.ts",
    "docs:screenshots:headless": "xvfb-run --auto-servernum --server-args=\"-screen 0 2560x1440x24\" bun x playwright test --config=e2e/capture-screenshots.playwright.config.ts",
    "lint": "NODE_ENV=test eslint . --cache --cache-location .eslintcache",
    "openspec:validate": "openspec validate --all",
    "test": "bun test ./tests",
    "test:coverage": "bun test ./tests --coverage --coverage-reporter=lcov",
    "test:e2e": "bun x playwright test",
    "test:e2e:headless": "xvfb-run --auto-servernum --server-args=\"-screen 0 2560x1440x24\" bun x playwright test",
    "typecheck": "tsc --noEmit",
    "vault:dev": "bun scripts/vault-dev.ts",
    "vault:dev:headless": "xvfb-run --auto-servernum --server-args=\"-screen 0 2560x1440x24\" bun scripts/vault-dev.ts --headless",
    "vault:eval": "bun scripts/vault-eval.ts",
    "vault:reload": "bun scripts/vault-reload.ts",
    "vault:screenshot": "bun scripts/vault-screenshot.ts",
    "vault:sync": "bun scripts/vault-sync.ts"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/core": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@fission-ai/openspec": "1.8.0",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "commander": "^15.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-yml": "^3.8.1",
    "fast-check": "^4.9.0",
    "globals": "17.9.0",
    "jiti": "^2.7.0",
    "obsidian-launcher": "^3.0.4",
    "ts-node": "^10.9.2",
    "tslib": "2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "obsidian": "1.13.1",
    "remeda": "^2.37.0",
    "temporal-polyfill": "^1.0.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "bd": "npm:@forbidden/do-not-install@0.0.0",
    "@beads/bd": "npm:@forbidden/do-not-install@0.0.0",
    "beads": "npm:@forbidden/do-not-install@0.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript-eslint/type-utils": "^8.66.0",
    "@typescript-eslint/types": "^8.66.0",
    "@typescript-eslint/utils": "^8.66.0",
    "typescript-eslint": "^8.66.0"
  }
}
